{
  "name": "dotnet-visual-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local.ps1",
    "local:preview": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local.ps1 -Preview",
    "setup": "npm ci",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.2"
  }
}
